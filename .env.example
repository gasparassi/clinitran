# Configuração do site Clinitran Exames
# Copie este arquivo para ".env" e preencha os valores.
# O .env guarda segredos: ele NUNCA deve ir para o git (já está no .gitignore).
# Em hospedagens que permitem definir variáveis de ambiente no painel,
# use os mesmos nomes abaixo e o .env não é necessário.

# ---------- Área administrativa (paginas/admin/) ----------
ADMIN_USUARIO=admin

# Gere o hash com:  composer gerar-senha -- "sua senha forte"
# Use ASPAS SIMPLES: o hash contém "$", que ferramentas como Docker e o shell
# interpretariam como variável (aspas simples deixam o valor exatamente como está).
ADMIN_SENHA_HASH=''

# ---------- Aviso automático por WhatsApp (Meta Cloud API) ----------
WHATSAPP_ATIVO=false

# Painel da Meta > WhatsApp > Configuração da API
WHATSAPP_TOKEN=''
WHATSAPP_PHONE_NUMBER_ID=''
WHATSAPP_VERSAO_API=v21.0

# Número da clínica que vai RECEBER o aviso (DDI + DDD + número, só dígitos)
WHATSAPP_DESTINO=5527998330777

# Modelo de mensagem aprovado pela Meta, com 5 variáveis no corpo:
# "Novo contato pelo site (protocolo {{1}}). Nome: {{2}}. Telefone: {{3}}. Assunto: {{4}}. Data de preferência: {{5}}."
WHATSAPP_MODELO=novo_contato_site
WHATSAPP_IDIOMA=pt_BR
